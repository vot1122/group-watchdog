# Copy this file to .env and fill in your values.
# Get API_ID / API_HASH from https://my.telegram.org -> "API development tools"

API_ID=123456
API_HASH=your_api_hash_here

# A name for the session file that is created on first login.
SESSION_NAME=watchdog

# The group to monitor. All of these work:
#   @your_group_username          (or just: your_group_username)
#   https://t.me/your_group        (public link)
#   https://t.me/+AbCdEf123        (invite link - group must be already joined)
#   https://t.me/joinchat/AbCdEf   (old-style invite link)
#   -1001234567890                (numeric chat id)
GROUP=@your_group_username

# SQLite database file (created automatically).
DB_PATH=presence.db

# Re-snapshot all members every N minutes (catches missed events and
# username/name changes). 30 is a safe value. 0 disables.
SNAPSHOT_EVERY=30

# ------------------------- log destinations (optional) --------------------

# Private Telegram group where logs get forwarded (create one, add yourself,
# put its @username or -100... id here). Leave EMPTY to disable.
LOG_GROUP=@my_private_log_group

# What goes to the log group:
#   alerts     - only flood / always-online / mass-deletion alerts
#   notable    - alerts + messages, edits, deletions, joins/leaves, name changes
#   everything - all of the above + every online/offline (batched into one
#                message every 5 minutes)
# WARNING: "everything" in a very active group can mean hundreds of forwarded
# messages per day from YOUR account. "notable" is the safer choice.
TG_LOG_LEVEL=everything

# ntfy.sh push notifications. Topic is like a password: anyone who knows it
# can read your notifications, so make it long and random, e.g.
#   NTFY_TOPIC=ananya-spam-watch-x7k2m9q4
# Install the ntfy app (Android/iOS) or open https://ntfy.sh/<your-topic>
# in a browser, then subscribe to the topic. Leave EMPTY to disable.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# What goes to ntfy:
#   alerts     - flood, always-online, mass-deletion (recommended; ntfy.sh
#                rate-limits heavy posting)
#   everything - alerts + all notable events, batched once a minute
NTFY_LEVEL=alerts

# ------------------------- other settings --------------------------------

# 1 = store message text (first 1000 chars) in the database.
# 0 = store only metadata (who/when/length/media), never any text.
LOG_MESSAGE_TEXT=1

# Alert thresholds:
# flood alert when someone sends this many messages within this many seconds:
FLOOD_MSGS=20
FLOOD_WINDOW=60
# alert when a user has been online continuously for this many hours:
ONLINE_ALERT_HOURS=24
# alert when a user deletes this many of their messages within FLOOD_WINDOW:
DELETE_ALERT=10
